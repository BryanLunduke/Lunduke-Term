+// Perf step 3: 16-bit fixed point textures. A value x is stored as round(x * scale), clamped to
+// 0..65535, and read back as k * (1 / scale).
+inline uint16_t toFixed16(float x, float scale) {
+    const float k = x * scale + 0.5f;
+    return static_cast<uint16_t>(k <= 0.0f ? 0.0f : (k >= 65535.0f ? 65535.0f : k));
+}
+// tex: uint16 fixed point, C channels per texel; inv = 1 / scale. Writes the first N channels.
+template <int N = 3, int C = 3>
+inline void sampleClamp(const uint16_t* tex, int w, int h, float u, float v, float inv, float out[4]) {
+    static_assert(N <= C, "N channels of a C-channel texture");
+    float x = u * w - 0.5f, y = v * h - 0.5f;
+    int x0 = ifloor(x), y0 = ifloor(y);
+    float fx = x - static_cast<float>(x0), fy = y - static_cast<float>(y0);
+    int x1 = clampi(x0 + 1, 0, w - 1), y1 = clampi(y0 + 1, 0, h - 1);
+    x0 = clampi(x0, 0, w - 1);
+    y0 = clampi(y0, 0, h - 1);
+    const uint16_t* a = tex + (static_cast<size_t>(y0) * w + x0) * C;
+    const uint16_t* b = tex + (static_cast<size_t>(y0) * w + x1) * C;
+    const uint16_t* c = tex + (static_cast<size_t>(y1) * w + x0) * C;
+    const uint16_t* d = tex + (static_cast<size_t>(y1) * w + x1) * C;
+    for (int i = 0; i < N; ++i) {
+        const float fa = a[i] * inv, fb = b[i] * inv, fc = c[i] * inv, fd = d[i] * inv;
+        float top = fa + (fb - fa) * fx;
+        float bot = fc + (fd - fc) * fx;
+        out[i] = top + (bot - top) * fy;
+    }
+}
