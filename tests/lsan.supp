# SPDX-License-Identifier: GPL-3.0-or-later
# LeakSanitizer suppressions for build-san (meson test sets LSAN_OPTIONS=suppressions=...).
# Only third-party caches that live until exit belong here, never our own code.
#
# fontconfig: the config, font set and patterns that pango's default font map caches for the
# life of the process (allocated via pango_layout_get_baseline -> pangoft2 -> FcFontSort etc.).
leak:libfontconfig.so

# view_test only (GTK + GL). Not fontconfig, listed here so leak checking can stay on:
# Mesa llvmpipe/GLX state behind GtkGLArea framebuffers (gtk_gl_area_attach_buffers) and the GLX
# screen/visual tables from gdk_display_manager_open_display -> epoxy_glx_version. They are
# allocated inside Mesa and live until exit; our code holds no pointer to them.
leak:libgallium-
leak:libGLX_mesa.so
# GDK X11: gdk_x11_display_set_window_scale() lists the toplevels with
# gdk_screen_get_toplevel_windows() and never frees the list (3 x 24 bytes per call).
leak:gdk_screen_get_toplevel_windows
