#!/usr/bin/make -f
# SPDX-License-Identifier: GPL-3.0-or-later
# Binary package for LCOS 1.1.0. See docs/PACKAGING.md and packaging/build-deb.sh.
export DEB_BUILD_MAINT_OPTIONS = hardening=+all

%:
	dh $@ --buildsystem=meson

override_dh_auto_configure:
	dh_auto_configure -- -Dbuildtype=plain

# view_test needs an X display; the GL match test runs on llvmpipe.
override_dh_auto_test:
ifeq (,$(filter nocheck,$(DEB_BUILD_OPTIONS)))
	xvfb-run -a -s "-screen 0 1280x1024x24" dh_auto_test --no-parallel
endif
